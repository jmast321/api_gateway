# =====================================================================
# OpenRouter Free Agent Gateway (Hermes AI Router) - Configuration
# =====================================================================

# OpenRouter API Key (ottenibile gratuitamente su https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Configurazione del Server Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
DEBUG=false

# Modalità di Routing:
# - SYNERGY: Unione ponderata di Analisi Euristica (0ms) + Classificatore LLM Free
# - HEURISTIC_ONLY: Decisione immediata a latenza zero e zero consumo di rate limit LLM
# - SHADOW_TEST: Euristica decide subito per l'utente, LLM classifica in background per confronto telemetria
DEFAULT_ROUTING_MODE=SYNERGY

# Intervallo aggiornamento automatico modelli Free (in minuti)
MODEL_REFRESH_INTERVAL_MINUTES=30

# Gestione Retry ed Errori (Backoff Esponenziale per 429 e 5xx)
MAX_RETRIES=3
BACKOFF_FACTOR=1.5
REQUEST_TIMEOUT_SECONDS=120.0

# Numero di modelli alternativi di fallback da preparare per ogni richiesta
FALLBACK_CANDIDATES_COUNT=3
